# =============================================================================
# STEP 27: Add descriptions to all activities
# =============================================================================
# Path: ... > <Category> > <Subcategory>
# Format: st "<activityname>" "activitydescription:<description>"

cd ~
cd Projects
cd "Residential Building Project"
cd "Activity Categories"

cd "Architecture"
cd "Architectural Design"
st "Prepare architectural drawings" "activitydescription:Full set of architectural drawings including floor plans elevations sections and details for the residential building"
st "Prepare floor plans" "activitydescription:Detailed floor plan layouts showing room arrangements dimensions and spatial relationships for all levels of the building"
cd ..
cd "Landscape Design"
st "Landscape planning and design" "activitydescription:Design and documentation of external landscape works including planting schemes pathways and outdoor living spaces"
cd ..
cd ..

cd "Structural Engineering"
cd "Design Development"
st "Prepare structural drawings" "activitydescription:Comprehensive structural engineering drawings covering all structural elements of the residential building including framing plans and details"
st "Foundation design and analysis" "activitydescription:Geotechnical report review and structural design of the building foundation system including pad foundation sizing and reinforcement"
cd ..
cd "Detailed Design"
st "Structural steel detailing" "activitydescription:Detailed shop drawings for structural steel elements including beams columns and connection details for fabrication and construction"
st "Concrete reinforcement detailing" "activitydescription:Preparation of reinforced concrete detailing drawings and bar bending schedules for all concrete structural members"
cd ..
cd ..

cd "Plumbing Engineering"
cd "Plumbing Design"
st "Prepare plumbing drawings" "activitydescription:Design and documentation of the domestic water supply sanitary drainage and plumbing systems for the residential building"
cd ..
cd ..

cd "Electrical Engineering"
cd "Electrical Design"
st "Prepare electrical wiring drawings" "activitydescription:Electrical wiring layout drawings including load calculations switchboard schedules and cable routing for the residential building"
st "HVAC system design" "activitydescription:Design of the heating ventilation and air conditioning system including ductwork layout equipment selection and energy load calculations"
st "Fire protection system design" "activitydescription:Design of the fire detection alarm and suppression systems including sprinkler layout and fire risk assessment for the residential building"
cd ..
cd ..
