ad "firstname:David,lastname:Wilson,email:david.wilson@engineering.com,password:arch202"
ad "firstname:Jennifer,lastname:Garcia,email:jennifer.garcia@engineering.com,password:draft707"
cd ..

# Electrical Engineering department
cd "Electrical Engineering"
ad "firstname:Jessica,lastname:Brown,email:jessica.brown@engineering.com,password:elec303"
ad "firstname:Robert,lastname:Martinez,email:robert.martinez@engineering.com,password:elec404"
