
# =============================================================================
# Complete Project Setup - Building Project
# Part 1: Departments
# =============================================================================
# This source file demonstrates all the steps required to set up a complete
# project in the osoem database, covering every entity type.
#
# Prerequisites:
#   - A clean database with the schema applied
#
# Auto-increment IDs assumed to start at 1 for all tables.
# =============================================================================


# =============================================================================
# STEP 1: Create departments
# =============================================================================
# Path: ~ > Organization > Departments
# Format: ad "departmentname:<name>"

cd ~
cd Organization
cd Departments
ad "departmentname:Project Management"
ad "departmentname:Structural Engineering"
ad "departmentname:Architecture"
ad "departmentname:Electrical Engineering"
ad "departmentname:Plumbing Engineering"
ad "departmentname:Mechanical Engineering"
ad "departmentname:Piping Engineering"
ad "departmentname:Instrumentation Engineering"


# =============================================================================
# STEP 2: Create employees
# =============================================================================
# Path: ~ > Organization > Departments > <Department>
# Format: ad "firstname:<first>,lastname:<last>,email:<email>,password:<pass>"
# The department ID is derived from the current location in the hierarchy.
#
# Employees (by ID):
#   1  - John Davis         (Project Management)
#   2  - Sarah Thompson     (Structural Engineering)
#   3  - Michael Chen       (Structural Engineering)
#   4  - Emily Rodriguez    (Architecture)
#   5  - David Wilson       (Architecture)
#   6  - Jessica Brown      (Electrical Engineering)
#   7  - Robert Martinez    (Electrical Engineering)
#   8  - Amanda Johnson     (Plumbing Engineering)
#   9  - Christopher Lee    (Plumbing Engineering)
#   10 - Jennifer Garcia    (Architecture)
#   11 - Marcus Brown       (Mechanical Engineering)
#   12 - Patricia Taylor    (Piping Engineering)
#   13 - Kevin Zhang        (Instrumentation Engineering)

# Project Management department
cd "Project Management"
ad "firstname:John,lastname:Davis,email:john.davis@engineering.com,password:manager123"
cd ..

# Structural Engineering department
cd "Structural Engineering"
ad "firstname:Sarah,lastname:Thompson,email:sarah.thompson@engineering.com,password:struct456"
ad "firstname:Michael,lastname:Chen,email:michael.chen@engineering.com,password:struct789"
cd ..

# Architecture department
