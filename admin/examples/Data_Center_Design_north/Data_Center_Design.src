# =============================================================================
# Complete Project Setup - Data Center Design
# =============================================================================
# This source file sets up the Data Center Design project (349024)
# in the osoem database.
#
# Prerequisites:
#   - A clean database with the schema applied
#   - The organization source file loaded (examples/Organization_Examples/departments.src)
#     or the following employees already present in the database:
#       John Davis, David Wilson, Sarah Thompson, Michael Chen,
#       Jessica Brown, Robert Martinez, Marcus Brown
#
# All data is imported directly from CSV files:
#   projectdata.csv
#   teamdata.csv           (flat file: employee + role per row)
#   activitydata.csv       (flat file: category + subcategory + activity per row)
#   milestonedata.csv      (flat file: milestone + step per row)
#   artefactdata.csv       (flat file: type + artefact + activity link + milestone link per row)
#   fielddata.csv          (flat file: artefact type + field definition per row)
#   artefactfielddata.csv  (flat file: artefact type + artefact + field value per row)
#   notesdata.csv          (flat file: category + subcategory + activity + note per row)
# =============================================================================



# =============================================================================
# STEP 1: Create the project
# =============================================================================
# Path: ~ > Projects
# Importing from: ./projectdata.csv

cd ~
cd Projects
im "./projectdata.csv"


# =============================================================================
# STEP 2: Add team members to the project
# =============================================================================
# Path: ~ > Projects > <Project> > Team
# Importing from: ./teamdata.csv
#
# The CSV contains EmployeeName and Role columns.
# Roles: 0 = No role, 1 = Team Member, 2 = Project Manager, 3 = Administrator

cd "Data Center Design North Project"
cd Team
im -r "./teamdata.csv"


# =============================================================================
# STEP 3: Import activity categories, subcategories, and activities
# =============================================================================
# Path: ~ > Projects > <Project> > Activity Categories
# Importing from: ./activitydata.csv
#
# The flat CSV contains categoryname, subcategoryname, and activityname columns.
# Recursive import (-r) creates categories, subcategories, and activities in one pass.

cd ~
cd Projects
cd "Data Center Design North Project"
cd "Activity Categories"
im -r "./activitydata.csv"


# =============================================================================
# STEP 4: Import milestones and milestone steps
# =============================================================================
# Path: ~ > Projects > <Project> > Milestones
# Importing from: ./milestonedata.csv
#
# The flat CSV contains milestonename, milestonestepname, and progressratio columns.
# Recursive import (-r) creates milestones and their steps in one pass.
#
# NOTE: Milestones must be imported before artefacts, as artefactdata.csv references
#       milestone step names.

cd ~
cd Projects
cd "Data Center Design North Project"
cd Milestones
im -r "./milestonedata.csv"


# =============================================================================
# STEP 5: Import artefact types, artefacts, activity links, and milestone links
# =============================================================================
# Path: ~ > Projects > <Project> > Artefact Types
# Importing from: ./artefactdata.csv
#
# The flat CSV contains:
#   artefactname      - artefact type (Drawing / Calculation / Datasheet)
#   artefacttitle     - artefact title
#   artefactownername - artefact owner (looked up by name)
#   categoryname      - activity category (for disambiguation)
#   subcategoryname   - activity subcategory (for disambiguation)
#   activityname      - activity to link the artefact to
#   ratio             - proportion of the artefact assigned to the activity
#   milestonestepname - milestone step to mark (optional)
#   completedbyname   - employee who completed the step (optional)
#   completiondate    - date the step was completed (optional)
#
# Recursive import (-r) handles the full hierarchy in one pass:
#   ArtefactType > Artefact > ArtefactToActivityLink > MilestoneToArtefactLink

cd ~
cd Projects
cd "Data Center Design North Project"
cd "Artefact Types"
im -r "./artefactdata.csv"


# =============================================================================
# STEP 6: Import artefact data field definitions
# =============================================================================
# Path: ~ > Projects > <Project> > Artefact Types
# Importing from: ./fielddata.csv
#
# The flat CSV contains artefactname, fieldtitle, valuetype, and maximumlength columns.
# Recursive import (-r) creates field definitions per artefact type in one pass.

cd ~
cd Projects
cd "Data Center Design North Project"
cd "Artefact Types"
im -r "./fielddata.csv"


# =============================================================================
# STEP 7: Import artefact field data values
# =============================================================================
# Path: ~ > Projects > <Project> > Artefact Types
# Importing from: ./artefactfielddata.csv
#
# The flat CSV contains artefactname, artefacttitle, artefactownername,
# fieldname, and value columns.
# Recursive import (-r) populates data values per artefact in one pass.

cd ~
cd Projects
cd "Data Center Design North Project"
cd "Artefact Types"
im -r "./artefactfielddata.csv"


# =============================================================================
# STEP 8: Add tasks, assignments, and hours
# =============================================================================
# Path: ~ > Projects > <Project> > Activity Categories > ...
#
# Tasks, assignments, and hours are defined inline below, organised in three
# sub-steps:
#   8a - Create tasks and sub-tasks for each activity
#   8b - Create task assignments (employee + date range)
#   8c - Book hours against each assignment

# =============================================================================
# STEP 8a: Create tasks and sub-tasks for each activity
# =============================================================================
# Path: ~ > Projects > <Project> > Activity Categories > <Category> > <Subcategory> > <Activity> > Tasks
# Format: ad "taskname:<name>,taskdescription:<desc>,departmentname:<dept>"

# Initiation and Planning > Project Charter > Project Charter
cd ~
cd Projects
cd "Data Center Design North Project"
cd "Activity Categories"
cd "Initiation and Planning"
cd "Project Charter"
cd "Project Charter"
cd Tasks
ad "taskname:Draft preparation,taskdescription:Prepare initial project charter draft,departmentname:Project Management"
ad "taskname:Charter sign-off,taskdescription:Obtain formal sign-off from project sponsor,departmentname:Project Management"
cd "Draft preparation"
cd Tasks
ad "taskname:Prepare write-up,taskdescription:Prepare formal write-up from the draft,departmentname:Project Management"
cd ..
cd ..
cd "Draft preparation"
cd Tasks
ad "taskname:Review write-up,taskdescription:Review the charter write-up with stakeholders,departmentname:Project Management"
cd ..
cd ..

