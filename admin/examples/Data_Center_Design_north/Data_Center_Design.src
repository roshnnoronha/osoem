ad "taskname:Financial analysis,taskdescription:Analyse project financial viability and cost estimates,departmentname:Project Management"
ad "taskname:Feasibility report,taskdescription:Compile and issue the feasibility study report,departmentname:Project Management"
cd "Site assessment"
cd Tasks
ad "taskname:Site visit,taskdescription:Conduct physical site visit and survey,departmentname:Project Management"
cd ..
cd ..
cd "Site assessment"
cd Tasks
ad "taskname:Site report,taskdescription:Write site assessment report,departmentname:Project Management"
cd ..
cd ..

