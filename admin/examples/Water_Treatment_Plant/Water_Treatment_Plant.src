# =============================================================================
# Complete Project Setup - Water Treatment Plant
# =============================================================================
# This source file sets up the Water Treatment Plant project (WTP-2024-005)
# in the osoem database.
#
# Prerequisites:
#   - A clean database with the schema applied
#   - The organization source file loaded (examples-Organization_Examples-departments.src)
#     or the following employees already present in the database:
#       John Davis, Sarah Thompson, Michael Chen, Emily Rodriguez,
#       Robert Martinez, Jessica Brown, Amanda Johnson,
#       Marcus Brown, Patricia Taylor, Kevin Zhang
#
#
# All data is imported directly from CSV files:
#   projectdata-projectdata.csv
#   categorydata-categorydata.csv
#   subcategorydata-<category>.subcategorydata.csv
#   activitydata-<category>.<subcategory>.activitydata.csv
#   artefacttypedata-artefacttypedata.csv
#   artefactfielddata-<type>.fielddata.csv
#   artefactdata-drawing.artefactdata.csv
#   artefactdata-calculation.artefactdata.csv
#   artefactdata-datasheet.artefactdata.csv
#   milestonedata-milestonedata.csv
#   milestonestepdata-milestonestepdata.csv
# =============================================================================



# =============================================================================
# STEP 1: Create the project
# =============================================================================
# Path: ~ > Projects
# Importing from: .-projectdata-projectdata.csv

cd ~
cd Projects
im "./projectdata/projectdata.csv"


# =============================================================================
# STEP 2: Add team members to the project
# =============================================================================
# Path: ~ > Projects > <Project> > Team
# Format: ad "employeename:<name>,role:<role>"
# Roles: 1 = Team Member, 2 = Project Manager, 3 = Administrator

cd "Water Treatment Plant"
cd Team
ad "employeename:John Davis,role:2"
ad "employeename:Sarah Thompson,role:1"
ad "employeename:Michael Chen,role:1"
ad "employeename:Emily Rodriguez,role:1"
ad "employeename:Robert Martinez,role:1"
ad "employeename:Jessica Brown,role:1"
ad "employeename:Amanda Johnson,role:1"
ad "employeename:Marcus Brown,role:1"
ad "employeename:Patricia Taylor,role:1"
ad "employeename:Kevin Zhang,role:1"


# =============================================================================
# STEP 3: Import activity categories
# =============================================================================
# Path: ~ > Projects > <Project> > Activity Categories
# Importing from: ./categorydata/categorydata.csv

cd ~
cd Projects
cd "Water Treatment Plant"
cd "Activity Categories"
im "./categorydata/categorydata.csv"


# =============================================================================
# STEP 4: Import activity subcategories
# =============================================================================
# Path: ~ > Projects > <Project> > Activity Categories > <Category>
# Importing per-category CSV files from subcategorydata-

cd "Bioreactors"
im "./subcategorydata/bioreactors.subcategorydata.csv"
cd ..

cd "Building Structures and HVAC"
im "./subcategorydata/building_structures_and_hvac.subcategorydata.csv"
cd ..

cd "Instrumentation"
im "./subcategorydata/instrumentation.subcategorydata.csv"
cd ..

cd "Mixers"
im "./subcategorydata/mixers.subcategorydata.csv"
cd ..

cd "Piping"
im "./subcategorydata/piping.subcategorydata.csv"
cd ..

cd "Post-Treatment Filters"
im "./subcategorydata/post_treatment_filters.subcategorydata.csv"
cd ..

cd "Pumps and Blowers"
im "./subcategorydata/pumps_and_blowers.subcategorydata.csv"
cd ..

cd "Solids Transfer"
im "./subcategorydata/solid_transfer.subcategorydata.csv"
cd ..

cd "System Controls"
im "./subcategorydata/system_controls.subcategorydata.csv"
cd ..

cd "Tanks"
im "./subcategorydata/tanks.subcategorydata.csv"
cd ..

cd "Valves and Fittings"
im "./subcategorydata/valves_and_fittings.subcategorydata.csv"
cd ..


