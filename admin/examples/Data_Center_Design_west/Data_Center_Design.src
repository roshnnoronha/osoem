# =============================================================================
# STEP 9: Import activity notes
# =============================================================================
# Path: ~ > Projects > <Project> > Activity Categories
# Importing from: ./notesdata.csv
#
# The flat CSV contains categoryname, subcategoryname, activityname,
# username, notedate, and note columns.
# Recursive import (-r) creates notes per activity in one pass.

cd ~
cd Projects
cd "Data Center Design West Project"
cd "Activity Categories"
im -r "./notesdata.csv"
